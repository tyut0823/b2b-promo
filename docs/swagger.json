{
  "openapi": "3.0.3",
  "info": {
    "title": "b2b-promo API",
    "version": "0.2.0",
    "description": "식자재 유통 B2B 샘플 신청 웹앱의 백엔드 API. 교육용 바이브코딩 실습 MVP. 9-plan.md 4절(BE-3, BE-5, BE-6, BE-7)에 확정된 엔드포인트만 포함한다."
  },
  "servers": [
    { "url": "http://localhost:3000" }
  ],
  "tags": [
    { "name": "auth", "description": "회원가입/로그인/토큰 재발급" },
    { "name": "samples", "description": "샘플 등록/수정/조회" },
    { "name": "applications", "description": "샘플 신청/취소/신청 현황" },
    { "name": "users", "description": "마이페이지(내 정보/비밀번호)" },
    { "name": "uploads", "description": "샘플 이미지 파일 업로드" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "description": "password_hash 등 비밀번호 관련 필드는 어떤 응답에도 포함하지 않는다.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "account_type": { "type": "string", "enum": ["ADMIN", "BUYER"], "description": "계정 유형" },
          "email": { "type": "string", "format": "email", "description": "로그인 ID" },
          "name": { "type": "string" },
          "company_name": { "type": "string", "nullable": true, "description": "소속 거래처명 (관리자는 없을 수 있음)" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Sample": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "description": "샘플명" },
          "description": { "type": "string", "nullable": true, "description": "상품 설명" },
          "image_url": { "type": "string", "nullable": true, "description": "이미지 경로/URL" },
          "start_date": { "type": "string", "format": "date", "description": "신청 시작일" },
          "end_date": { "type": "string", "format": "date", "description": "신청 종료일" },
          "created_at": { "type": "string", "format": "date-time" },
          "status": {
            "type": "string",
            "enum": ["SCHEDULED", "ONGOING", "ENDED"],
            "description": "예정/진행중/종료 상태. DB에 저장되는 컬럼이 아니며, 서버가 start_date/end_date와 현재 날짜를 비교해 매 요청마다 계산해서 응답에 포함한다."
          }
        }
      },
      "SampleInput": {
        "type": "object",
        "required": ["name", "start_date", "end_date"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "image_url": { "type": "string", "nullable": true },
          "start_date": { "type": "string", "format": "date" },
          "end_date": { "type": "string", "format": "date" }
        }
      },
      "Application": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "sample_id": { "type": "string", "format": "uuid" },
          "user_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["APPLIED", "CANCELLED"] },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "ApplicationWithSample": {
        "description": "내 신청 내역 조회용. 신청 정보에 신청 대상 샘플 정보를 포함한다.",
        "allOf": [
          { "$ref": "#/components/schemas/Application" },
          {
            "type": "object",
            "properties": {
              "sample": { "$ref": "#/components/schemas/Sample" }
            }
          }
        ]
      },
      "ApplicationWithUser": {
        "description": "관리자의 샘플별 신청 현황 조회용. 신청 정보에 신청한 거래처 담당자 정보를 포함한다.",
        "allOf": [
          { "$ref": "#/components/schemas/Application" },
          {
            "type": "object",
            "properties": {
              "user": { "$ref": "#/components/schemas/User" }
            }
          }
        ]
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string" },
          "refresh_token": { "type": "string" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        },
        "example": { "message": "이미 신청한 샘플입니다." }
      }
    }
  },
  "paths": {
    "/auth/signup": {
      "post": {
        "tags": ["auth"],
        "summary": "거래처 담당자 자가 회원가입",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "name", "company_name"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "format": "password" },
                  "name": { "type": "string" },
                  "company_name": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "회원가입 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "400": {
            "description": "중복 이메일 등 잘못된 요청",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "로그인",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "format": "password" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공, access/refresh token 발급",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenPair" } } }
          },
          "400": {
            "description": "필수 항목(email, password) 누락",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "이메일 또는 비밀번호 불일치",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["auth"],
        "summary": "refresh token으로 access token 재발급",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refresh_token"],
                "properties": {
                  "refresh_token": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "access token 재발급 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "access_token": { "type": "string" } }
                }
              }
            }
          },
          "400": {
            "description": "필수 항목(refresh_token) 누락",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "만료되거나 위조된 refresh token",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/samples": {
      "get": {
        "tags": ["samples"],
        "summary": "샘플 목록 조회 (신청 종료된 샘플 제외)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "샘플 목록",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Sample" } }
              }
            }
          },
          "401": {
            "description": "인증되지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "post": {
        "tags": ["samples"],
        "summary": "샘플 등록 (관리자 전용)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SampleInput" } } }
        },
        "responses": {
          "201": {
            "description": "등록 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Sample" } } }
          },
          "400": {
            "description": "필수 항목(name, start_date, end_date) 누락 또는 end_date가 start_date보다 이전",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "인증되지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "403": {
            "description": "관리자 권한 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/samples/{id}": {
      "get": {
        "tags": ["samples"],
        "summary": "샘플 상세 조회",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "샘플 상세",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Sample" } } }
          },
          "401": {
            "description": "인증되지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "샘플 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "put": {
        "tags": ["samples"],
        "summary": "샘플 수정 (관리자 전용)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SampleInput" } } }
        },
        "responses": {
          "200": {
            "description": "수정 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Sample" } } }
          },
          "400": {
            "description": "필수 항목(name, start_date, end_date) 누락 또는 end_date가 start_date보다 이전",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "인증되지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "403": {
            "description": "관리자 권한 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "샘플 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/samples/{id}/applications": {
      "get": {
        "tags": ["samples"],
        "summary": "샘플별 신청 현황 조회 (관리자 전용)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "해당 샘플을 신청한 거래처 담당자 목록과 상태",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ApplicationWithUser" } }
              }
            }
          },
          "401": {
            "description": "인증되지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "403": {
            "description": "관리자 권한 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "샘플 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/applications": {
      "post": {
        "tags": ["applications"],
        "summary": "샘플 신청 (또는 취소한 신청의 재신청)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sample_id"],
                "properties": {
                  "sample_id": { "type": "string", "format": "uuid" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "신청 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Application" } } }
          },
          "400": {
            "description": "필수 항목(sample_id) 누락이거나, 신청 시작일 이전이거나 신청 종료일이 경과하여 신청이 거부됨",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "인증되지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "샘플 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "409": {
            "description": "이미 신청한 샘플에 대한 중복 신청",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "message": "이미 신청한 샘플입니다." }
              }
            }
          }
        }
      }
    },
    "/applications/{id}": {
      "patch": {
        "tags": ["applications"],
        "summary": "신청 취소 (레코드는 유지되고 status만 CANCELLED로 변경)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": { "type": "string", "enum": ["CANCELLED"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "취소 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Application" } } }
          },
          "400": {
            "description": "status 값이 CANCELLED가 아님",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "인증되지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "403": {
            "description": "본인의 신청이 아님",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "신청 내역 없음 (이미 취소된 경우 포함)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/applications/me": {
      "get": {
        "tags": ["applications"],
        "summary": "내 신청 내역 조회",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "내가 신청한 샘플 목록과 각 신청의 상태",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ApplicationWithSample" } }
              }
            }
          },
          "401": {
            "description": "인증되지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "tags": ["users"],
        "summary": "내 정보 조회",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "내 정보",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "401": {
            "description": "인증되지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "put": {
        "tags": ["users"],
        "summary": "내 정보 수정 (이름, 소속 거래처명)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "company_name": { "type": "string", "nullable": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "401": {
            "description": "인증되지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/users/me/password": {
      "put": {
        "tags": ["users"],
        "summary": "비밀번호 변경",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["current_password", "new_password"],
                "properties": {
                  "current_password": { "type": "string", "format": "password" },
                  "new_password": { "type": "string", "format": "password" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "비밀번호 변경 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "message": { "type": "string" } }
                }
              }
            }
          },
          "400": {
            "description": "필수 항목(current_password, new_password) 누락 또는 현재 비밀번호 불일치",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "인증되지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/uploads": {
      "post": {
        "tags": ["uploads"],
        "summary": "샘플 이미지 파일 업로드 (관리자 전용)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "업로드 성공. 반환된 url을 샘플 등록/수정 시 image_url로 사용한다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "url": { "type": "string", "description": "Supabase Storage의 공개 URL. 예: https://<project-ref>.supabase.co/storage/v1/object/public/sample-images/1700000000000-123456789.png" } }
                }
              }
            }
          },
          "400": {
            "description": "업로드할 파일이 없음",
